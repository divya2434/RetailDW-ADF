{
	"name": "DS_ADLS_Bronze",
	"properties": {
		"linkedServiceName": {
			"referenceName": "AzureDataLakeStorage1",
			"type": "LinkedServiceReference"
		},
		"parameters": {
			"pFolderName": {
				"type": "string",
				"defaultValue": "dbo"
			},
			"pFileName": {
				"type": "string",
				"defaultValue": "@concat(item().SourceName, '.csv')"
			}
		},
		"annotations": [],
		"type": "DelimitedText",
		"typeProperties": {
			"location": {
				"type": "AzureBlobFSLocation",
				"fileName": {
					"value": "@dataset().pFileName",
					"type": "Expression"
				},
				"folderPath": {
					"value": "@dataset().pFolderName",
					"type": "Expression"
				},
				"fileSystem": "bronze1"
			},
			"columnDelimiter": ",",
			"escapeChar": "\\",
			"firstRowAsHeader": true,
			"quoteChar": "\""
		},
		"schema": [
			{
				"name": "CustomerID",
				"type": "String"
			},
			{
				"name": "CustomerName",
				"type": "String"
			},
			{
				"name": "Gender",
				"type": "String"
			},
			{
				"name": "DOB",
				"type": "String"
			},
			{
				"name": "Email",
				"type": "String"
			},
			{
				"name": "Phone",
				"type": "String"
			},
			{
				"name": "City",
				"type": "String"
			},
			{
				"name": "State",
				"type": "String"
			},
			{
				"name": "Country",
				"type": "String"
			},
			{
				"name": "JoinDate",
				"type": "String"
			}
		]
	},
	"type": "Microsoft.DataFactory/factories/datasets"
}